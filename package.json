{
  "name": "fertigung-einfach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx --env-file-if-exists=.env watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "ALLOW_LIVE_TESTS=1 vitest run --config vitest.live.config.ts",
    "db:generate": "drizzle-kit generate",
    "test:db": "vitest run --config vitest.db.config.ts",
    "admin:create-coordinator": "tsx --env-file-if-exists=.env server/cli/createCoordinator.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/cli/migrate.ts",
    "setup:mac": "bash scripts/setup-mac.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "lucide-react": "^1.52.0",
    "mysql2": "^3.24.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "superjson": "^2.2.6",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
